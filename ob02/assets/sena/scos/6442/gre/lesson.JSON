ontent": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Listen to the audio. Type in the missing words. \n", "type": "text"}]}], "id": 9, "type": "TYP"}, {"questions": [{"responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "type": "RSLT"}, {"questions": [{"responses": [{"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn9le07ob02re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " \nDescribe an activity you can do at home to help you destress.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n", "type": "text"}]}], "id": 11, "type": "DWS"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "id": 0, "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"template_override": 1, "title": "", "contents": [{"type": "video", "value": {"images": [{"time": "0", "image": "", "id": 0, "text": ""}, {"time": "100", "image": "", "id": 1, "text": "Stress can overtake your life and leave you feeling very helpless. Haven't you wondered how to relieve that stress at home? You have to find a way to cope or it can be overwhelming. Doctors recommend finding an activity that you love doing, and make it an enjoyable experience. One such example might be baking. Can't you feel yourself relaxing already? Baking is a great way to help you destress. Have your spouse, children, or a fiend help you. It could make it a more engaging experience. You could also get a group friends to come over after. Get them to bring their own baked goodies for a nice tea party."}, {"time": "36000", "image": "", "id": 2, "text": "Visualize it! If you have children and prefer baking alone, have your spouse take the children to the movies. Now, the kitchen is yours! Can't you just imagine yourself stirring, adding, folding, and pouring in a warm kitchen? Get your tools ready. Have the fresh ingredients all arranged nicely on the kitchen counter. Don't you think having your favourite song play in the background while you mix the ingredients together would be soothing? Mmmm. Smell the aroma of your freshly baked masterpiece as you take it out of the oven. Don't you feel better already?"}, {"time": "72000", "image": "", "id": 3, "text": "So, find something you love doing and do it, even if it's something simple like baking. Wouldn't you agree it's the best way to fight stress?"}], "video_src": "engenn9le07ob02re2vid01"}}], "_data": [], "id": 2, "type": "video"}]}], "_data": [{"type": "metadata", "contents": [{"content": "Sharing the Housework", "type": "lesson_name"}, {"content": "Keep Calm and Bake a Lot", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 7, "type": "lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": " Describe ways of solving problems and getting things done in work and social contexts.", "type": "primary"}, {"content": " Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace", "type": "secondary_1"}, {"content": " Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace", "type": "secondary_2"}, {"content": " Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace", "type": "secondary_3"}, {"content": " Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace", "type": "secondary_4"}, {"content": " Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace", "type": "secondary_5"}, {"content": " Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace", "type": "secondary_6"}, {"content": " Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace", "type": "secondary_7"}, {"content": " Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace", "type": "secondary_8"}]}, {"content": "engenn9le07ob02re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " The Causative - get/have", "type": "heading"}, {"content": " You use a causative verb when you want to talk about something that someone else did for you or for another person. It means that the subject caused the action to happen, but didn't do it themselves. ", "type": "describer"}, {"content": "You use the causative verbs <span class=\"italic\">get</span>/<span class=\"italic\">have </span>when you want to make it clear that the subject paid, asked, or persuaded the other person to do something.  ", "type": "text"}, {"content": " I have problems getting my roommates to do chores around the house.", "type": "example"}, {"content": "It's a great way to have your roommates participate in the chores. ", "type": "example"}, {"content": "She told me that I should get you to give me some advice. ", "type": "example"}, {"content": "First off you need to have them do their own laundry. ", "type": "example"}, {"content": "Perhaps you could get a teenager in the neighborhood to mow the lawn.", "type": "example"}, {"content": "For example: <br /><span class=\"italic\">You could also <span class=\"strong\">get</span> a group friends <span class=\"strong\">to come</span> over after. </span> ", "type": "text"}, {"content": "In this sentence <span class=\"italic\">you </span>asks or persuades <span class=\"italic\">a group of friends</span> to come over.</span> <br />", "type": "text"}, {"content": "The structure of the causative is: <br /><br /> Subject + <span class=\"italic\">have</span> + object + verb <br /><br /> <span class=\"italic\"><span class=\"strong\">You</span> can <span class=\"strong\">have your spouse take</span> the children to the movies.</span> ", "type": "text"}, {"content": "or ", "type": "text"}, {"content": "Subject + <span class=\"italic\">get</span> + object + infinitive  <br /><br /> <span class=\"italic\"><span class=\"strong\">Get them to bring</span> their own baked goodies for a nice tea party.</span>", "type": "text"}, {"content": "Sometimes, you use <span class=\"italic\">get</span> when you want to convey the feeling that you need to convince someone to do something. <span class=\"italic\">Have</span> is a little more neutral.", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": " Negative Questions To Encourage Agreement", "type": "heading"}, {"content": " Negative questions have a different meaning than regular questions. ", "type": "describer"}, {"content": "A negative question can be used to ask for confirmation of something you believe to be true.", "type": "text"}, {"content": "Wouldn't you agree it's the best way to fight stress?", "type": "example"}, {"content": "Don't you think your favourite song playing in the background while you mix the ingredients together would be soothing?", "type": "example"}, {"content": "Can't you just imagine yourself stirring, adding, folding, pouring and in a warm kitchen?", "type": "example"}, {"content": "Haven't you wondered how to relieve that stress at home? ", "type": "example"}, {"content": "<ul> \t<li> \t<span class=\"italic\">Can't you feel yourself relaxing already? </span> \t\t <ul> \t\t\t<li>(= <span class=\"italic\">I think you can feel yourself relaxing.</span>)</li> \t\t</ul> \t</li> </ul>", "type": "text"}, {"content": "With this type of question, you anticipate that the listener will agree with you and answer 'yes'.  ", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to destress", "type": "name"}, {"content": " to liberate from stress", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Baking is a great way to help you destress.", "type": "example"}, {"content": "engenn9le07ob02aud02", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about destressing at home.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "overwhelming ", "type": "name"}, {"content": "to overpower or overcome in mind or feeling", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You have to find a way to cope or it can be overwhelming.", "type": "example"}, {"content": "engenn9le07ob02aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to overtake", "type": "name"}, {"content": "to come alongside or catch up with and pass", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Stress can overtake your life and leave you feeling very helpless.", "type": "example"}, {"content": "engenn9le07ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "spouse ", "type": "name"}, {"content": "husband or wife", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Have your spouse take the children to the movies. ", "type": "example"}, {"content": "engenn9le07ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to recommend", "type": "name"}, {"content": "to give an advice", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Doctors recommend finding an activity that you love doing, and make it an enjoyable experience. ", "type": "example"}, {"content": "engenn9le07ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "counter", "type": "name"}, {"content": "flat surface for the preparation of food in a kitchen", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Have the fresh ingredients all arranged nicely on the kitchen counter.", "type": "example"}, {"content": "engenn9le07ob02aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to fold ", "type": "name"}, {"content": "to bend", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Can't you just imagine yourself stirring, adding, folding,  and pouring in a warm kitchen? ", "type": "example"}, {"content": "engenn9le07ob02aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "aroma", "type": "name"}, {"content": "pleasant odor", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Smell the aroma of your freshly baked masterpiece as you take it out of the oven.", "type": "example"}, {"content": "engenn9le07ob02aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "masterpiece", "type": "name"}, {"content": " a person's greatest piece of work", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Smell the aroma of your freshly baked masterpiece as you take it out of the oven.", "type": "example"}, {"content": "engenn9le07ob02aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "background ", "type": "name"}, {"content": "things at the back or rear", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Don't you think having your favourite song play in the background while you mix the ingredients together would be soothing? ", "type": "example"}, {"content": "engenn9le07ob02aud10", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Read the text again.", "type": "text"}, {"content": "Think of another activity someone could do at home to destress.", "type": "text"}, {"content": "Write a description of that activity that could make someone want to try it.", "type": "text"}, {"content": "Use words for domestic activities.", "type": "text"}, {"content": "Explain how this activity can help solve the stress problem.", "type": "text"}, {"content": "Encourage agreement.", "type": "text"}, {"content": "Read your text aloud to a partner.", "type": "text"}, {"content": "Discuss your idea with them.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write a text on how to destress doing a domestic activity.", "type": "text"}, {"content": "I talk about solving the problem.", "type": "text"}, {"content": "I use vocabulary for domestic activities.", "type": "text"}, {"content": "I use questions to encourage agreement.", "type": "text"}, {"content": "I share my idea with a partner and discuss it.", "type": "text"}]}], "type": "sena"}
": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "id": 10, "template_override": 1}, {"type": "DWS", "_data": [{"type": "instructions", "contents": [{"content": " \nFind some recipes for non-toxic household cleaner.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Writing", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n", "type": "text"}]}], "questions": [{"responses": [{"id": 0, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "engenn9le07ob05re7pdf01.pdf", "type": "pdf"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "type": "welcome", "_data": [], "contents": [{}]}, {"type": "video", "_data": [], "title": "", "template_override": 1, "id": 2, "contents": [{"value": {"video_src": "engenn9le07ob05re2vid01", "images": [{"text": "", "image": "", "time": "0", "id": 0}, {"text": "Cleaning can be a very tedious task don't you think? You need to know how to clean and what to use to do it. Cleaning can be dangerous too. Don't you want to take the proper precautions to be safe while doing it? Of course you do. Here are some tips to make your cleaning experience is a positive one.\nFor wiping floors, sinks and tiles, you may want to use chemical cleaners. First check the label. Use the correct amount. Too little won't clean properly. Too much can be toxic or hurt your hands. You might also want to wear rubber gloves.", "image": "", "time": "100", "id": 1}, {"text": "Don't mix cleaners together. This can produce toxic fumes that can be detrimental to your health. Wouldn't you prefer not to end up in emergency?\nLeaving cleaners accessible if you have children is also a big hazard. Don't you agree? Make sure that they are up high or in a cupboard with a childproof lock.", "image": "", "time": "34000", "id": 2}, {"text": "Vacuuming can also pose a risk if not handled correctly. Plug it into an outlet that isn't overcrowded. You wouldn't want to start a fire or get a shock would you? Move things out of the way so you don't trip. Pick up anything that could block the vacuum hose when sucked in, such as pins, or cotton balls! You don't want to have to get your vacuum repaired, do you?\nCleaning your house can be hazardous if you don't take the right precautions. So, isn't it better to be safe than sorry?", "image": "", "time": "52000", "id": 3}]}, "type": "video"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Sharing the Housework", "type": "lesson_name"}, {"content": "Vacuum at Your Own Risk", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 7, "type": "lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe ways of solving problems and getting things done in social contexts.", "type": "primary"}, {"content": "Placeholder", "type": "secondary_1"}, {"content": "Placeholder", "type": "secondary_2"}, {"content": "", "type": "secondary_3"}, {"content": "", "type": "secondary_4"}, {"content": "", "type": "secondary_5"}, {"content": "", "type": "secondary_6"}, {"content": "", "type": "secondary_7"}, {"content": "", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": " Negative Questions To Encourage Agreement", "type": "heading"}, {"content": " Negative questions have a different meaning than regular questions. ", "type": "describer"}, {"content": "A negative question can be used to ask for confirmation of something you believe to be true.", "type": "text"}, {"content": "<ul> <li>  <span class=\"italic\">Wouldn't you prefer not to end up in emergency?</span> <ul> <li>(= <span class=\"italic\">I think you would prefer to not end up in emergency.</span>)</li> \t\t</ul> \t</li> </ul>", "type": "text"}, {"content": "With this type of question, you anticipate that the listener will agree with you and answer 'yes'.  ", "type": "text"}, {"content": "Sometimes, the question can come at the end of the statement. This is more casual.", "type": "text"}, {"content": "For example:<br /><span class=\"italic\">Cleaning can be a very tedious task, don't you think? </span>", "type": "text"}, {"content": "Don't you want to take the proper precautions to be safe while doing it?", "type": "example"}, {"content": "Don't you agree?", "type": "example"}, {"content": "Isn't it better to be safe than sorry?", "type": "example"}, {"content": "You wouldn't want to start a fire or get a shock, would you? ", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "proper ", "type": "name"}, {"content": "adapted or suitable to the purpose or circumstances; fit", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Don't you want to take the proper precautions to be safe while doing it?", "type": "example"}, {"content": "engenn9le07ob05aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about cleaning the house.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "precaution ", "type": "name"}, {"content": "an action taken beforehand to protect against possible danger, failure", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Cleaning your house can be hazardous if you don't take the right precautions.", "type": "example"}, {"content": "engenn9le07ob05aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to wipe", "type": "name"}, {"content": "to rub, move, or pass (a cloth, for example) over a surface", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example:  For wiping floors, sinks and tiles, you may want to use chemical cleaners.", "type": "example"}, {"content": "engenn9le07ob05aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "detrimental ", "type": "name"}, {"content": "can cause harm", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: This can produce toxic fumes that can be detrimental to your health. Wouldn't you prefer not to end up in emergency?", "type": "example"}, {"content": "engenn9le07ob05aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "tedious ", "type": "name"}, {"content": "time-consuming, task that takes a long time and is boring", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Cleaning can be a very tedious task.", "type": "example"}, {"content": "engenn9le07ob05aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to childproof ", "type": "name"}, {"content": "to modify an area or thing in order to be safe from the tampering of young children", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Make sure that they are up high or in a cupboard with a childproof lock.", "type": "example"}, {"content": "engenn9le07ob05aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "label ", "type": "name"}, {"content": "an item used to identify something or someone, as a small piece of paper or cloth attached to an article to designate its origin, owner, contents, use, or destination", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: First, check the label of the detergents.", "type": "example"}, {"content": "engenn9le07ob05aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "fumes ", "type": "name"}, {"content": "vapour, gas, or smoke, especially if irritating, harmful, or strong", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: This can produce toxic fumes that can be detrimental to your health. Wouldn't you prefer not to end up in emergency?", "type": "example"}, {"content": "engenn9le07ob05aud09", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Go online and find out what recipes are available for non-toxic cleaners for you house.", "type": "text"}, {"content": "Take some notes.", "type": "text"}, {"content": "Use the notes to write up summaries for three cleaning alternatives.", "type": "text"}, {"content": "Read these to an adult female you know and find out what they think of these cleaners and whether they would be interested in trying them.", "type": "text"}, {"content": "Bring your recipes and comments from the adult female to class.", "type": "text"}, {"content": "Share the finding with a partner and discuss them.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": " I look up alternative non-toxic recipes for household cleaners.", "type": "text"}, {"content": "I write summaries on my findings for three cleaners.", "type": "text"}, {"content": "I ask an adult female for their opinion on them.", "type": "text"}, {"content": "I share my recipe and comments made by the female with a partner and discuss them.", "type": "text"}]}, {"content": "engenn9le07ob05re1img01.jpg", "type": "background_image"}, {"type": "target_word", "contents": [{"content": "rubber gloves", "type": "name"}, {"content": "gloves made out of rubber worn to protect the hands while performing tasks involving chemicals", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You might also want to wear rubber gloves.", "type": "example"}, {"content": "engenn9le07ob05aud05", "type": "audio"}]}]}
incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn9le07ob09re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nTalk about things people argue over.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn9le07ob09re2img01.jpg"}, {"text": "Dear Sally,<br/>\nI need help. I just had a huge argument with my boyfriend! He does not listen to me and that isn't right, is it? Whenever I ask him to help out around the house, he just does not do it. I've been unhappy about it, so I started to complain. He got his coat, said he was not coming back and left! I'm very upset. I have no idea what to do!<br/>\nUpset", "id": 1, "time": "100", "image": "engenn9le07ob09re2img01.jpg"}, {"text": "Dear Upset,<br/>\nFirst, don't worry. He only took his coat, right? My boyfriend did not want to take out the trash, and he should, right? When I told him it was his turn, he stormed out saying the same thing. He did not want to do any of the chores and that's not fair, is it? He felt that me, the woman, should do everything. We had a long serious talk. I told him that if the relationship wasn't working out we could go our separate ways. If he valued it, we would have to work things out.", "id": 2, "time": "24000", "image": "engenn9le07ob09re2img02.jpg"}, {"text": "I explained that I couldn't work, cook, clean, do laundry, take out the garbage and shop for food. I was not able to do it all alone, was I? He could not expect me to either, could he? We came up with a compromise. This is what you have to do next. Evaluate your situation and make decisions. Otherwise, things will not change, will they?<br/>\nSally", "id": 3, "time": "56800", "image": "engenn9le07ob09re2img05.jpg"}], "audiosrc": "engenn9le07ob09re2aud01", "coverimg": "engenn9le07ob09re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}